        "message": "<Field> doesn't accept that prop. Declared props: label, optional, hint, error, dark, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|links|logoSrc|brand|loginLabel|loginHref|ctaLabel|onCta|fixed|style|key|ref|className|style|children)$/]",
        "message": "<GlobalHeader> doesn't accept that prop. Declared props: theme, links, logoSrc, brand, loginLabel, loginHref, ctaLabel, onCta, fixed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalHeader'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:auto|light|dark)$/]",
        "message": "<GlobalHeader> theme must be one of 'auto' | 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|style|key|ref|className|style|children)$/]",
        "message": "<Headline> doesn't accept that prop. Declared props: as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<Headline> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:dark|mesh|eyebrow|title|sub|primaryLabel|secondaryLabel|onPrimary|onSecondary|primaryHref|secondaryHref|style|children|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: dark, mesh, eyebrow, title, sub, primaryLabel, secondaryLabel, onPrimary, onSecondary, primaryHref, secondaryHref, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='mesh'] > Literal[value!=/^(?:aurora|emerald|indigo|nightfall|veil)$/]",
