        "selector": "JSXOpeningElement[name.name='TitleSlide'] > JSXAttribute[name.name='mesh'] > Literal[value!=/^(?:aurora|emerald|indigo|nightfall|veil)$/]",
        "message": "<TitleSlide> mesh must be one of 'aurora' | 'emerald' | 'indigo' | 'nightfall' | 'veil'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|light|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: text, light, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
