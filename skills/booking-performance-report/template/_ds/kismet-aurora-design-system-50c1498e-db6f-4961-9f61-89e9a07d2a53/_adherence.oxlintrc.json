        "message": "<Section> doesn't accept that prop. Declared props: variant, mesh, grain, container, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|mist|dark|aurorabg)$/]",
        "message": "<Section> variant must be one of 'white' | 'mist' | 'dark' | 'aurorabg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='mesh'] > Literal[value!=/^(?:aurora|emerald|indigo|nightfall|veil)$/]",
        "message": "<Section> mesh must be one of 'aurora' | 'emerald' | 'indigo' | 'nightfall' | 'veil'."
      },
