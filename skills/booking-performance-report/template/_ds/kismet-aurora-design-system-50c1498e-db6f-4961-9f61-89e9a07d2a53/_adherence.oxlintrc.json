        "message": "<Quote> doesn't accept that prop. Declared props: children, by, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|by|brand|meta|style|key|ref|className|style|children)$/]",
        "message": "<QuoteSlide> doesn't accept that prop. Declared props: quote, by, brand, meta, style."
