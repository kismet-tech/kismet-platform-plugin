      },
      {
        "selector": "JSXOpeningElement[name.name='PressWall'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|names|style|key|ref|className|style|children)$/]",
        "message": "<PressWall> doesn't accept that prop. Declared props: label, names, style."
      },
      {
