{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blocks/**",
              "components/charts/**",
              "components/core/**",
              "components/deck/**",
              "components/forms/**",
              "components/header/**",
              "components/signature/**",
              "ui_kits/marketing-site/**",
              "ui_kits/pitch-deck/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|IBM Plex Mono|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, IBM Plex Mono, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|series|height|formatValue|style|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: data, series, height, formatValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigStatSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|value|caption|brand|meta|style|children|key|ref|className|style|children)$/]",
        "message": "<BigStatSlide> doesn't accept that prop. Declared props: eyebrow, value, caption, brand, meta, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletsSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|items|media|brand|meta|style|key|ref|className|style|children)$/]",
        "message": "<BulletsSlide> doesn't accept that prop. Declared props: eyebrow, title, items, media, brand, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|note|children|brand|meta|style|key|ref|className|style|children)$/]",
        "message": "<ChartSlide> doesn't accept that prop. Declared props: eyebrow, title, note, children, brand, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dark|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|left|right|brand|meta|style|key|ref|className|style|children)$/]",
        "message": "<CompareSlide> doesn't accept that prop. Declared props: eyebrow, title, left, right, brand, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|buttonLabel|mesh|onClick|href|style|key|ref|className|style|children)$/]",
        "message": "<CtaBanner> doesn't accept that prop. Declared props: title, buttonLabel, mesh, onClick, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBanner'] > JSXAttribute[name.name='mesh'] > Literal[value!=/^(?:aurora|emerald|indigo|nightfall|veil)$/]",
        "message": "<CtaBanner> mesh must be one of 'aurora' | 'emerald' | 'indigo' | 'nightfall' | 'veil'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DividerSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:no|title|mesh|brand|meta|style|key|ref|className|style|children)$/]",
        "message": "<DividerSlide> doesn't accept that prop. Declared props: no, title, mesh, brand, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DividerSlide'] > JSXAttribute[name.name='mesh'] > Literal[value!=/^(?:aurora|emerald|indigo|nightfall|veil)$/]",
        "message": "<DividerSlide> mesh must be one of 'aurora' | 'emerald' | 'indigo' | 'nightfall' | 'veil'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailCapture'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|ctaLabel|onSubmit|hint|dark|style|key|ref|className|style|children)$/]",
        "message": "<EmailCapture> doesn't accept that prop. Declared props: placeholder, ctaLabel, onSubmit, hint, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, style."
      },
      {
